# The app runs with none of these set: progress is kept on the device and the
# account, assistant and reminder features stay off. Copy to .env.local to turn them on.

# Accounts and sync (Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the reminder job to read push subscriptions.
SUPABASE_SERVICE_ROLE_KEY=

# Study assistant. Server only; never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Reminders (generate a pair with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the scheduled reminder job sends as a bearer token.
CRON_SECRET=
