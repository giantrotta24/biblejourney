# The app runs with none of these set: progress is kept on the device and the
# account, assistant and reminder features stay off. Copy to .env.local to turn them on.

# Accounts and sync (Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the reminder job to read push subscriptions, and by the
# study assistant to keep its daily limit and answer cache in Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Study assistant. Server only; never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local development only: 1 lets signed-out requests use the assistant with an
# in-memory limit. Ignored whenever NODE_ENV is production.
ASSISTANT_ALLOW_ANONYMOUS=

# Reminders (generate a pair with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the scheduled reminder job sends as a bearer token.
CRON_SECRET=
